# ========================================
# HUGGING FACE SECRETS
# ========================================
# Add these as Repository Secrets in Hugging Face Space:
# Settings → Repository secrets

# Django Configuration
SECRET_KEY=django-insecure-GENERATE-NEW-KEY-HERE
DEBUG=False
ALLOWED_HOSTS=*

# Database Configuration
# Get from MongoDB Atlas: Database → Connect → Connect your application
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/scamshield?retryWrites=true&w=majority

# AI API Keys
# Get from: https://console.groq.com
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE

# Email Configuration (for notifications)
# Use Gmail App Password: https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password

# CORS Configuration
# Add your Vercel frontend URL
CORS_ALLOWED_ORIGINS=https://scamshield.vercel.app,https://scamshield-preview.vercel.app

# ========================================
# GENERATE SECRET KEY
# ========================================
# Run this command to generate a new SECRET_KEY:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
